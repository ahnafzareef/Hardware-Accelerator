#CMD bind click-3 -action selection
#CMD bind ctrl-click-1 -action selection_append
#CMD bind shift-click-1 -action {}
#CMD bind {click-1-button @iexplode} -action iexplode-obj-const
#CMD bind {click-1-button @iexplode2} -action iexplode-obj-const
#CMD bind {click-1-button @icollapse} -action icollapse-obj-const
