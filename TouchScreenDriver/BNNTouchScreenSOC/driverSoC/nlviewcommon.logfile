search -exists inst *
#R 1
#CMD gsave -string -flagsOSRD
pagesize
#R 2597 1381
zoom
#R 1.16629
clear
search -exists inst *
#R 0
search -exists port *
#R 0
search -exists portBus *
#R 0
search -exists cgraphic *
#R 0
property pinpermute 0
property netindicators 0
dbg -netnet 10
module new driverSystem_imp -nosplit
#  * Current module is driverSystem_imp 
search -exists inst *
#R 0
search -exists port *
#R 0
search -exists portBus *
#R 0
search -exists cgraphic *
#R 0
